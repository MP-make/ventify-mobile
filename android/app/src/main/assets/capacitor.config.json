{
	"appId": "pe.com.ventify.pos",
	"appName": "Ventify POS",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"plugins": {
		"BarcodeScanner": {
			"targetedFormats": [
				"EAN_13",
				"EAN_8",
				"CODE_128",
				"CODE_39",
				"UPC_A",
				"UPC_E",
				"QR_CODE"
			]
		},
		"SplashScreen": {
			"launchShowDuration": 1500,
			"launchAutoHide": true,
			"backgroundColor": "#047857",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		}
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": true
	}
}
