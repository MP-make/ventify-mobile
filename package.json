{
  "name": "ventify-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App móvil de Ventify POS (React + Vite + Capacitor para Android)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:copy": "cap copy android",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run cap:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@zxing/browser": "0.1.5",
    "firebase": "^11.10.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vite": "^8.2.0"
  }
}
